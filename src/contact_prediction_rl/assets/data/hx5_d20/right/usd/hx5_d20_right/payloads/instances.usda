#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "hx5_d20_base_unit" (
        prepend references = @./geometries.usd@</Geometries/hx5_d20_base_unit>
    )
    {
        over "hx5_d20_base_unit" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/hx5_d20_base_unit/VisualMaterials/grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey>
            )
            {
            }
        }
    }

    def Xform "hx5_d20_base_unit_1" (
        prepend references = @./geometries.usd@</Geometries/hx5_d20_base_unit>
    )
    {
        over "hx5_d20_base_unit" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"

            def Scope "material"
            {
                custom string urdf:name = "grey"

                def Scope "color"
                {
                    custom string urdf:rgba = "0.2 0.2 0.2 1"
                }
            }
        }
    }

