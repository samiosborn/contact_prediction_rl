#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "red"
    {
        color3f inputs:diffuseColor = (1, 0, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
            doc = '''Represents the universal "displacement" output terminal of a 
        material.'''
        )
        prepend token outputs:displacement.connect = </Materials/red/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
            doc = '''Represents the universal "surface" output terminal of a
        material.'''
        )
        prepend token outputs:surface.connect = </Materials/red/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
            doc = '''Represents the universal "volume" output terminal of a
        material.'''
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/red.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/red.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/red.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/red.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "grey"
    {
        color3f inputs:diffuseColor = (0.033104762, 0.033104762, 0.033104762)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
            doc = '''Represents the universal "displacement" output terminal of a 
        material.'''
        )
        prepend token outputs:displacement.connect = </Materials/grey/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
            doc = '''Represents the universal "surface" output terminal of a
        material.'''
        )
        prepend token outputs:surface.connect = </Materials/grey/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
            doc = '''Represents the universal "volume" output terminal of a
        material.'''
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/grey.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/grey.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/grey.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/grey.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}

